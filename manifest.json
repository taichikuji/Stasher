{
  "manifest_version": 3,
  "name": "Stasher",
  "version": "2.2.0",
  "description": "Yet Another Tab Manager by @taichikuji",
  "homepage_url": "https://github.com/taichikuji/Stasher",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "contextMenus"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "action": {
    "default_title": "Click to Stash"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": "Alt+S"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "icons": {
    "16": "assets/icon_16.png",
    "32": "assets/icon_32.png",
    "48": "assets/icon_48.png",
    "128": "assets/icon_128.png"
  }
}
